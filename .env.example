APP_ENV=dev
DB_URL=sqlite:///data/assistant.db
OWNER_PSID=console-user
CHANNEL=console

# Messenger (separate values for dev and prod!)
FB_PAGE_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ID=

# LLM (OpenAI-compatible). Leave LLM_BASE_URL empty to use the offline rule parser.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct-2507
LLM_REPORT_MODEL=qwen3:8b
PARSER=auto

# Optional: urgent e-mail fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# Optional read-only calendar sync: secret iCal (ICS) URL(s), comma-separated. Empty = off.
# Google Calendar: Settings -> your calendar -> Integrate calendar -> "Secret address in iCal format".
CALENDAR_ICS_URLS=
CALENDAR_SYNC_MINUTES=15
CALENDAR_HORIZON_DAYS=14
